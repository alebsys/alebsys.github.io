---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, fullTitle, postHref } from '../../lib/posts';

const posts = await getPosts('en');
---
<Base
  title="Aleksandr Lebedev — performance engineering"
  lang="en"
>
  <h1>Aleksandr Lebedev</h1>

  <p>
    Performance engineer at an HFT fund. My work is low latency across the whole stack: code, runtime, OS, hardware.
  </p>

  <p>
    Before that I was an SRE responsible for reliability at one of the largest
    e-commerce companies in Russia.
  </p>

  {posts.length > 0 && (
    <>
      <h2>Posts</h2>
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={postHref('en', post.id)}>{fullTitle(post.data)}</a>
            <span class="date">{formatDate(post.data.date, 'en')}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Projects</h2>
  <ul>
    <li>
      <a href="https://github.com/cloudflare/ebpf_exporter">cloudflare/ebpf_exporter</a>:
      TCP retransmits instrumentation, xfsdist/ext4dist port, cachestat
      migration from kprobe to kfunc and tracepoints
    </li>
    <li>
      <a href="https://github.com/prometheus/procfs">prometheus/procfs</a>:
      UDP drops parsing support
    </li>
  </ul>

  <h2>Contact</h2>
  <p>
    Telegram: <a href="https://t.me/alebsys">@alebsys</a> ·
    LinkedIn: <a href="https://www.linkedin.com/in/alebsys/">@alebsys</a>
  </p>
</Base>
